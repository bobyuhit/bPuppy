# =============================================================
# bPuppy ESP32-S3 — 覆盖板级默认值
# 针对 ESP32-S3 WROOM-1 N16R8 (16MB Flash, 8MB Octal PSRAM)
#
# 板级 ESP32_GENERIC_S3/sdkconfig.board 默认 8MB QIO 80MHz，
# 此文件在其之后加载，覆盖为 16MB + 16MB 分区表
# =============================================================

# Flash 16MB QIO 80MHz (WROOM-1 N16R8)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 16MB 分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- 关闭 USB-JTAG (释放 GPIO 19/20 给 UART2) ----
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- 日志级别: INFO (调试 BLE 连接用, 部署可改回 ERROR) ----
CONFIG_LOG_DEFAULT_LEVEL_ERROR=
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- 相机 DMA 缓冲走 PSRAM (esp32-camera) ----
# 实测 (2026-09-16): psram_mode=false 时 cam_hal.c:520 要在**内部 RAM** 里分配
# 一块连续 16KB 当 DMA 缓冲; 内部 RAM 碎片化后拿不到 → esp_camera_init 直接失败,
# 报 "DMA buffer 16384 Byte malloc failed, the current largest free block:14848"。
# 开这个开关后 (cam_hal.c:491-495,520): 帧缓冲改到 PSRAM (MALLOC_CAP_SPIRAM),
# 上面那块 16KB 内部 RAM **整块不再申请** —— 不是更容易拿到, 是根本不要了。
# 代价: 帧数据经 PSRAM 做 DMA (N16R8 是 octal PSRAM, S3 支持), 帧率上限略降。
# 验证: 启动日志会打 "cam_hal: PSRAM DMA mode enabled" (走 UART0, 蓝牙看不到)。
CONFIG_CAMERA_PSRAM_DMA=y
