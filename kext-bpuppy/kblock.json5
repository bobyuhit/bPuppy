{
  libs:{
    "*":{import:'import poses, bpuppy_motion, bpuppy_servo, bpuppy_imu, voice, time, balance, heading_anchor as anc\nfrom time import sleep\n\n_speed = 2.5\n_stride = 70\n_lift = 30\n_height = 70\n_dir = 1\n\n# _ok: 上一次设置类积木是否真的生效 (被拒时固件保持原值)\n#   设置块直接用固件返回的 True/False (set_params / set_speed / set_turn 的返回值\n#   已透传到 MicroPython), 不再靠 get_params() 读回比对 —— 没有取整容差误判。\n#   「设置成功？」积木就是读这个值。\n_ok = True\n\n# 原厂已 init_all + 站姿待命, 不再重复初始化 (init_all 非幂等, 重复会失能跳变)\n# IMU: **这里就先起起来** —— 它的姿态滤波要 ~4.5s 才收敛, 现在开始算, 等用户点\n#   「航向锁定 偏转」或「偏航角」时早就稳了 (I2C 读数, 不跟 WiFi/蓝牙抢射频)。\n#   幂等: 用户再点「初始化 IMU」也只是一次空调用。\nbpuppy_imu.init(0, 14, 21, 0x68)\n# 语音: voice 上电已自启动 (UART2/9600 + 后台线程), 事件积木函数 voiceWhen* 自动注册\nvoice.set_main_globals(globals())   # 事件函数扫描用主全局 (sys.modules[__main__] 为 None)'},
  },
  blocks: [
    "## $$cat_pose",
    {
      opcode: 'stand',
      blockType: 'command',
      text: '$$stand',
      pycode: "poses.stand()"
    },
    {
      opcode: 'crouch',
      blockType: 'command',
      text: '$$crouch',
      pycode: "poses.crouch()"
    },
    {
      opcode: 'sit',
      blockType: 'command',
      text: '$$sit',
      pycode: "poses.sit()"
    },
    {
      opcode: 'playBow',
      blockType: 'command',
      text: '$$playBow',
      pycode: "poses.play()"
    },
    {
      opcode: 'waveBlock',
      blockType: 'command',
      text: '$$waveBlock',
      pycode: "poses.wave()"
    },
    {
      opcode: 'waitSec',
      blockType: 'command',
      text: '$$waitSec',
      arguments: {
        SEC: {
          type: 'number',
          defaultValue: '1'
        }
      },
      pycode: 'sleep([SEC])'
    },
    "---",
    "## $$cat_motion",
    {
      opcode: 'stop',
      blockType: 'command',
      text: '$$stop',
      pycode: "bpuppy_motion.set_gait('stop')"
    },
    // ⚠ 四个方向块都推一句 set_speed(_speed) —— 看着冗余, 但**别删**:
    //   这一句让网页遥控器/文本块把速度设成 7 之后, 按「前进」能回到 _speed (初值 2.5,
    //   「设置速度」块会同步更新它 ⇒ 对纯积木用户两种写法等价)。
    // ★★ 方向是**独立参数** set_direction(±1), 不寄居在步长的符号里。
    //   所以「后退」块写 set_direction(-1) + set_params(_stride, ...) ——
    //   **步长的幅度一点不变**, 只有方向翻; 写成 set_params(-abs(_stride), ...) 会被固件
    //   拒绝 (步长只表幅度) 并嘤嘤叫。四个块都显式说方向, 没有"按当前步长符号猜"的隐含行为。
    // ★★ 注意: 这四个块最后都推 set_gait('go'), 而 go 会**接管** stride/lift/height
    //   ⇒ 这几句 set_params 在 go 下数值被固件忽略 (只被保存)。真正决定速度的是上面那句
    //   set_speed(_speed); 想让 _stride/_lift/_height 生效, 得用 walk/trot。
    {
      opcode: 'forward',
      blockType: 'command',
      text: '$$forward',
      pycode: "bpuppy_motion.set_direction(1); bpuppy_motion.set_turn(0); bpuppy_motion.set_speed(_speed); bpuppy_motion.set_params(_stride, _lift, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'backward',
      blockType: 'command',
      text: '$$backward',
      pycode: "bpuppy_motion.set_direction(-1); bpuppy_motion.set_turn(0); bpuppy_motion.set_speed(_speed); bpuppy_motion.set_params(_stride, _lift, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnLeft',
      blockType: 'command',
      text: '$$turnLeft',
      pycode: "bpuppy_motion.set_direction(1); bpuppy_motion.set_turn(-0.8); bpuppy_motion.set_speed(_speed); bpuppy_motion.set_params(_stride, _lift, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnRight',
      blockType: 'command',
      text: '$$turnRight',
      pycode: "bpuppy_motion.set_direction(1); bpuppy_motion.set_turn(0.8); bpuppy_motion.set_speed(_speed); bpuppy_motion.set_params(_stride, _lift, _height); bpuppy_motion.set_gait('go')"
    },
    "---",
    "## $$cat_voice",
    {
      opcode: 'voiceWhen',
      blockType: 'hat',
      text: '$$voiceWhen',
      micropy: { instance: 'voice.start()' },
      pycode: ['def voiceWhen[VOICE]()'],
      arguments: {
        VOICE: {
          type: 'value',
          menu: 'voiceMenu',
          defaultValue: 'Fwd'
        }
      }
    },
    {
      opcode: 'getSoundAngle',
      blockType: 'reporter',
      text: '$$getSoundAngle',
      pycode: 'voice.SoundAngle'
    },
    // ⚠ 这个积木的 pycode 必须是**纯 ASCII**。KittenBlock 生成/下发代码时会把非 ASCII
    //   字符抹掉: 写成 voice.play('汪汪') 会变成 voice.play('') → play() 查不到名字回退到
    //   汪汪, 结果点哪个声音都汪汪 (实测 2026-09-26)。所以这里用 voice.say(*voice.SND_xxx)
    //   而不是声音名字 —— 码值的唯一真源仍在 frozen/voice.py 的 SND_WANG / SND_YING。
    // 加新声音 = frozen/voice.py 加一个 SND_xxx 常量 (第 4 字节不同) + 下面 soundMenu
    //   加一行, 这个积木的 pycode 不用动。
    {
      opcode: 'voiceSound',
      blockType: 'command',
      text: '$$voiceSound',
      arguments: {
        SOUND: {
          type: 'value',
          menu: 'soundMenu',
          defaultValue: 'WANG'
        }
      },
      pycode: 'voice.say(*voice.SND_[SOUND])'
    },
    // 播报数字: 滑块 0-100 (与 frozen/voice.py 的 NUM_MIN/NUM_MAX 对应) → 帧 AA 55 72 <n> 55 AA。
    // 固件侧还会再钳一道 (REPL 手敲 / 变量传值都可能越界), 所以滑块范围改了要同步改常量注释。
    {
      opcode: 'voiceSayNum',
      blockType: 'command',
      text: '$$voiceSayNum',
      arguments: {
        NUM: {
          type: 'slider',
          defaultValue: '0',
          min: 0,
          max: 100
        }
      },
      pycode: 'voice.say_num([NUM])'
    },
    "---",
    "## $$cat_servo",
    {
      opcode: 'setServo',
      blockType: 'command',
      text: '$$setServo',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        },
        ANGLE: {
          type: 'number',
          defaultValue: '90'
        }
      },
      pycode: 'poses.set_servo([SERVO],[ANGLE])'
    },
    {
      opcode: 'setStep',
      blockType: 'command',
      text: '$$setStep',
      arguments: {
        STEP: {
          type: 'number',
          defaultValue: '3'
        }
      },
      pycode: 'poses.set_step([STEP])'
    },
    {
      opcode: 'commitPose',
      blockType: 'command',
      text: '$$commitPose',
      pycode: 'poses.commit()'
    },
    {
      opcode: 'getServoAngle',
      blockType: 'reporter',
      text: '$$getServoAngle',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        }
      },
      pycode: 'poses.get_servo_angle([SERVO])'
    },
    {
      opcode: 'oscillate',
      blockType: 'command',
      text: '$$oscillate',
      arguments: {
        SERVO2: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '1'
        },
        AMP: {
          type: 'number',
          defaultValue: '10'
        },
        HZ: {
          type: 'number',
          defaultValue: '4'
        },
        CYCLES: {
          type: 'number',
          defaultValue: '8'
        }
      },
      pycode: 'poses.oscillate([SERVO2],[AMP],[HZ],[CYCLES])'
    },
    "---",
    "## $$cat_gait",
    // ===== 组合块: 一次设完 步长/身体高度/抬脚高度 =====
    // 只管三个身体尺寸 (块名「运动参数」, 分类「高级运动」/cat_gait);
    //   步态/速度/方向/转弯率各有单参数小块 (「速度设为」并入方向下拉, 见 setSpeed)。
    // ⚠ 这个块的 text 是**一行**(单个 $$key)。就算写成数组也**不会竖排** —— 2026-09-27 实测,
    //   见 §5.3: KittenBlock 给每个扩展积木硬写了 inputsInline: true, scratch-blocks 就把
    //   所有值输入挤回同一行。能强制换行的只有语句输入槽 (SUBSTACK), 那要 conditional +
    //   branchCount, 代价是行间多一个空 C 形槽 —— 不值。**要让积木短, 靠缩文案, 别指望换行。**
    // ⚠ 一行只能有一个 $$key: maybeFormatMessage 只有在**整行**以 $$ 开头时才查表,
    //   且把 $$ 之后的整串当一个 key。
    // ⚠⚠ pycode 必须是**单行** (整段无内部换行) —— 网页版在线执行按 20 字符分片、
    //   每片等回显确认, 分片里含换行会让设备当场执行上一行、把提示符插进回显
    //   ⇒ 回显对不上 ⇒ 整个命令被中止 (2026-10-02 查实, 详见 setSpeed 的详注)。
    //   语句间用 `;` 连接; 条件回写用**条件表达式** (`a if c else b`), 不用 `if` 语句。
    {
      opcode: 'advMotion',
      blockType: 'command',
      text: '$$advMotion',
      arguments: {
        STRIDE: { type: 'number', defaultValue: '70' },
        HEIGHT: { type: 'number', defaultValue: '70' },
        LIFT:   { type: 'number', defaultValue: '30' }
      },
      // 三个值 (步长/抬脚/站高) 是同一条足端轨迹的三个维度, 固件侧**一起判、一起写** ——
      // 不存在"用谁的旧值校验谁"的顺序问题 (见 docs/error.md §2.2 #7)。
      // ⚠ 方向**不在这个块里**: 本块只改尺寸, 前后由**独立的方向参数**决定并原样保持
      //   (set_params 根本不碰 direction), 所以「后退」之后改步长不会掉头。
      // ★ 必须回写 _stride/_lift/_height **三个**模块全局 (都取正数), 否则之后按「前进/后退」
      //   会拿旧全局覆盖 —— 尤其 _lift 漏掉时, 设过的抬脚高度会被静默写回 30。
      // 步态**不在这里设**: 改尺寸不打断当前步态, 狗该怎么走还怎么走。
      // 返回值就是固件的判定结果 (整组被拒 ⇒ False + 嘤嘤叫), 不再读回比对。
      // ★★ 走 `go` 步态时这三个值**固件侧一概不用** —— go 的步长/站高/抬脚
      //    全由速度自己算 —— speed≤4: 步长70/站高70/抬脚30; speed≥6: 步长50/站高70/抬脚5;
      //    中间线性插值 (见 AGENTS.md「GO 自适应」表)。方向**不受 go 影响** (独立参数)。
      //    四个方向块用的都是 go ⇒ 本块设的值对「前进/后退/左转/右转」**没有影响**,
      //    要让它生效得先用「切换步态」选 walk 或 trot。下面那句回写仍然必须留着:
      //    walk/trot 下它就是真的在起作用。
      // ⚠★ 本块 pycode 是**单行**: 顶格、无内部换行、一条复合语句都不许有 —— 不能写 `if`。**铁律。**
      //   (`if` 段在友善 REPL 上闭不了合、整段不执行 —— 见 AGENTS.md 易错点 13;
      //    内部换行则会被网页版的"分片等回显"中途掐死 —— 见 setSpeed 的详注。)
      //   条件回写用条件表达式 (`a if c else b`); 失败嘤嘤用 `or` 短路, 见下面那行。
      // ★ abs() 从此**只用于回写全局**: set_params 收原值 ⇒ 负步长才会走到固件那条
      //   `!(stride >= 0)` (motion_task.cpp:1350) 被拒 + 嘤嘤叫, 兑现
      //   docs/micropython编程指南.md「1.2 运动指令 bpuppy_motion」的参数表
      //   与 扩展开发.md「固件对负 stride 直接拒」的承诺 (以前 abs 在前, 那条闸门永远够不到)。
      //   被拒时三个全局**不写**, 与固件"整组被拒一个都不写" (motion_task.cpp:1364-1368) 一致。
      pycode: '_ok = bpuppy_motion.set_params([STRIDE], [LIFT], [HEIGHT]); _stride = abs([STRIDE]) if _ok else _stride; _lift = [LIFT] if _ok else _lift; _height = [HEIGHT] if _ok else _height; _ok = _ok or voice.say(*voice.SND_YING) or False'
    },
    {
      opcode: 'getStride',
      blockType: 'reporter',
      text: '$$getStride',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[1]'
    },
    {
      opcode: 'getHeight',
      blockType: 'reporter',
      text: '$$getHeight',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[2]'
    },
    {
      opcode: 'getLift',
      blockType: 'reporter',
      text: '$$getLift',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[3]'
    },
    // 「速度 [SPEED] 方向 [DIR]」: [DIR] 是 value 型菜单 (值裸代入) ⇒ 1=前进 / -1=后退。
    //   速度和方向**各走各的函数** (set_speed / set_direction), 改一个不碰另一个;
    //   set_params 只收步长**幅度**, 跟 [DIR] 无关。
    //   只动速度/方向 —— 高度/抬脚/转弯率/步态都不碰; 狗在走的话是**边走边改**。
    //   速度不打断步态, 也**不会**让站着的狗起步 (要起步还是用「前进/后退」)。
    // ⚠★ pycode 一律**顶格单句**且**单行**(无内部换行, 见 setSpeed 详注), 一条复合语句都不许有 —— 不写 `if`, 更不写 `else:`/`elif:`。
    //   只删 `else:` 不算修干净 —— 留着 `if` 照样死: REPL 判"说完没有"只看
    //   缓冲区末尾是不是 \n (py/repl.c:149), 而自动缩进连"空行"也填空格 (readline.c:503-527),
    //   于是 `if` 段永远等不到那个空行、整段一行都不执行; 续行里 Ctrl-C 又是**静默整段丢弃**
    //   (readline.c:158-160 → pyexec.c:446-450)。现象就是"点了没反应、不嘤、也没报错"。
    //   实测确认, 并被 bTool 的 _paste_by_lines_ok() 判据独立印证 (btool.py:1791-1804)。
    //   所以这里各调各的, 失败嘤嘤改用 `or` 短路收尾 (见 AGENTS.md 易错点 13)。
    {
      opcode: 'setSpeed',
      blockType: 'command',
      text: '$$setSpeed',
      arguments: {
        SPEED: {
          type: 'number',
          defaultValue: '2.5'
        },
        DIR: {
          type: 'value',
          menu: 'dirMenu',
          defaultValue: '1'
        }
      },
      // ⚠⚠ **必须是单行 (整段不能有内部换行)。** 网页版 KittenBlock 走 Web Bluetooth 时,
      //   在线执行 (execLine) 会把整条命令**按 20 字符切片、逐片发送、每片等"原样回显"
      //   确认** (beginEchoWait); 分片里含换行时, 设备 REPL 收到 `\r` 会**当场执行上一行**
      //   并把 `>>> ` 提示符插进回显流 → 回显子串对不上 → JS **发 Ctrl-C 中止**, 后面的
      //   分片一片都不发 (2026-10-02 实测: 6 行 pycode 只发出第 1 片 20 字符
      //   `_speed = 5\r\n_dir = 1`, 设备只执行了 _speed=5, `_dir = 1` 还被 Ctrl-C 从
      //   输入缓冲清掉 —— 速度纹丝不动)。
      //   ⇒ **pycode 一律单行** (`;` 连接): 中间分片没有换行 → 不执行 → 回显原样 →
      //   任意长度都安全 (afterConnect 的 58 字符单行一直好使就是证据; 「蹲下」单行同理)。
      //   ⚠ 仍然不许 if/def 等复合语句 (会卡 REPL 续行, 见 AGENTS.md 易错点 13)。
      pycode: '_speed = [SPEED]; _dir = [DIR]; bpuppy_motion.set_direction(_dir); bpuppy_motion.set_speed(_speed); _ok = True'
    },
    // ---- 读数积木 (读**板上生效值**) ----
    // ⚠ `disableMonitor: false` 是**必须写的**: KittenBlock 把舞台 monitor 的勾选框放宽到了任意
    //   reporter (GUI 侧条件 `!disableMonitor && 无参数`, lib.min.js:748702), 但主控板扩展的建块
    //   路径把 reporter 的 `disableMonitor` **默认写成 true** (lib.min.js:639959) ⇒ 不写这一行,
    //   积木栏里就**没有勾选框**, 用户没法把它们放到舞台上实时看生效值。
    //   (带参数的 reporter 想开监控还要再加 `forceEnableMonitor: true` —— 「舵机角度」没开, 另议。)
    // ⚠ 舞台读数框 = **每帧**求值一次 = 每帧一趟串口往返, 没有节流 ⇒ 数字会跳得比实际慢。
    // ⚠ 主控板模式**没有「外观」分类** ⇒ 「说」积木拿不到, 文档里别教"塞进说"。
    {
      opcode: 'getSpeed',
      blockType: 'reporter',
      text: '$$getSpeed',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[0]'
    },
    // ★ 方向读数 ([7]) —— 与「步长」分开。「步长」返回的是**带符号**的幅度×方向,
    //   想看"到底朝哪边走"看这个; 想看"迈多大步"看「步长」再取绝对值。两个都留着。
    {
      opcode: 'getDir',
      blockType: 'reporter',
      text: '$$getDir',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[7]'
    },
    {
      opcode: 'setGait',
      blockType: 'command',
      text: '$$setGait',
      arguments: {
        GAIT: {
          type: 'string',
          menu: 'gaitMenu',
          defaultValue: 'go'
        }
      },
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_gait([GAIT])"
    },
    // ⚠ set_turn 超范围时**静默钳到 ±1** (行为未变), 但现在会返回 False ⇒ 直接就是 _ok,
    //   不必再读回比对。注意 False 的含义是"没原样采纳", 值本身已经写进去了 (±1)。
    {
      opcode: 'setTurn',
      blockType: 'command',
      text: '$$setTurn',
      arguments: {
        TURN: {
          type: 'number',
          defaultValue: '0'
        }
      },
      // ⚠ 顶格单句 + 单行, 不许有复合语句 (见 setSpeed 详注)。注意 False 只是"没原样采纳", 值已钳位写入。
      pycode: '_ok = bpuppy_motion.set_turn([TURN]); _ok = _ok or voice.say(*voice.SND_YING) or False'
    },
    {
      opcode: 'getTurn',
      blockType: 'reporter',
      text: '$$getTurn',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[5]'
    },
    // C 签名是 (俯仰, 滚转) —— 跟块上文字「俯仰 [PITCH]…滚转 [ROLL]」同序,
    // 所以 pycode 按 [PITCH], [ROLL] 顺着写即可, 不会串。
    // ★★ 本块走组合校验: 姿态补偿是逐腿叠加进 z 的 (前腿 +z_pitch / 后腿
    //    -z_pitch, 左 -z_roll / 右 +z_roll), 跟 stride/height/lift 一样决定足端够不够得着,
    //    所以走同一条 traj_combo_bad()。够不着 ⇒ **俯仰横滚一个都不写、保持原值**、返回 False
    //    ⇒ 嘤嘤叫 + 「设置成功？」为假。
    //    **默认 stride70/height70 下 |俯仰| ≤ 5.81°、|横滚| ≤ 6.15°** (源码注释说"实测在用"
    //    的 -5 能过, -6 就被拒) —— 想压更大姿态先减步长: stride 40 时 -10 能过。
    //    也就是说"先设参数再压姿态"这个顺序耦合**没有了**, 反过来压也一样拦得住
    //    (docs/error.md §2.2 #2)。
    // 仍然不写 NVS、设了就保持 (块里不复位, 与现有语义一致)。
    {
      opcode: 'bodyPose',
      blockType: 'command',
      text: '$$bodyPose',
      arguments: {
        PITCH: { type: 'number', defaultValue: '0' },
        ROLL:  { type: 'number', defaultValue: '0' }
      },
      // ⚠ 顶格单句 + 单行, 不许有复合语句 (见 setSpeed 详注)。
      //   最后一段靠 `or` 短路: _ok 假才求值 voice.say ⇒ 嘤; 尾部 or False 把 say 返回的
      //   None 收回真 bool ⇒「设置成功？」读数不变。见 AGENTS.md 易错点 13。
      pycode: '_ok = bpuppy_motion.set_body_pose([PITCH], [ROLL]); _ok = _ok or voice.say(*voice.SND_YING) or False'
    },
    // 「设置成功？」: 上一次设置类积木(运动参数/速度/转弯率)是否**真的生效**。
    // 原理: 直接读固件返回的 True/False (set_params / set_speed / set_turn 的返回值
    //   已透传到 MicroPython) —— 不是"写完读回来比对", 所以没有取整容差误判。
    //   set_turn 返回 False 表示"没原样采纳"(已钳到 ±1), 值本身是写进去了的。
    // ⚠ 「重心偏移」没有读回接口, 但 set_center **返回 bool** ⇒ 它跟别的设置块一样
    //   参与 `_ok`; 同理「机身姿态」(bodyPose) 也参与。
    {
      opcode: 'setOk',
      blockType: 'boolean',
      text: '$$setOk',
      pycode: '_ok'
    },
    "---",
    "## $$cat_sensor",
    {
      opcode: 'initImu',
      blockType: 'command',
      text: '$$initImu',
      pycode: 'bpuppy_imu.init(0, 14, 21, 0x68)'
    },
    {
      opcode: 'getRoll',
      blockType: 'reporter',
      text: '$$getRoll',
      pycode: 'bpuppy_imu.read_angles()[0]'
    },
    {
      opcode: 'getPitch',
      blockType: 'reporter',
      text: '$$getPitch',
      pycode: 'bpuppy_imu.read_angles()[1]'
    },
    {
      opcode: 'getYaw',
      blockType: 'reporter',
      text: '$$getYaw',
      pycode: 'bpuppy_imu.read_angles()[2]'
    },
    // 航向锁定 (2026-10-01) —— 走 heading_anchor (step1 产 err) + heading_follow (step2 执行)。
    // ⚠ 「偏转」收的是**角度量**("从现在再转多少"), 不是绝对航向。yaw 本身是绝对的, 而磁力计
    //   一乱它就跟着**位置**变、不跟着**朝向**变(今天实测), 所以只有相对量可信。
    // ⚠ anc.on() **首次**调用阻塞 ~2.5s (在等 IMU 姿态滤波收敛), 之后秒回。
    // ★ 已锁定时再点一次 = **只换目标** —— 不重起线程 ⇒ turn 不掉 0, 弯是平滑拉过去的。
    // ⚠ 两个块都是**顶格单句、纯 ASCII、无复合语句** (AGENTS.md 易错点 13)。
    {
      opcode: 'lockHeading',
      blockType: 'command',
      text: '$$lockHeading',
      arguments: {
        DEG: {
          type: 'number',
          defaultValue: '0'
        }
      },
      pycode: 'anc.on([DEG])'
    },
    {
      opcode: 'unlockHeading',
      blockType: 'command',
      text: '$$unlockHeading',
      pycode: 'anc.off()'
    },
    // 自平衡 (2026-10-09) —— start 立即返回 (控制循环在后台线程), 期间写类指令被拒,
    //   只放 balance.stop 通过 (语音触发的动作同样被拒)。两块均顶格单句 (AGENTS.md 易错点 13/15)。
    {
      opcode: 'balanceOn',
      blockType: 'command',
      text: '$$balanceOn',
      pycode: 'balance.start()'
    },
    {
      opcode: 'balanceOff',
      blockType: 'command',
      text: '$$balanceOff',
      pycode: 'balance.stop()'
    },
    "---",
    "## $$cat_system",
    // 本类目前只有这一个块 —— 「重心偏移」。放这里是因为它**是唯一会写 NVS 的运动参数**
    //   (下面第一行), 属于"系统级设置"而不是日常调参。
    //   校准类积木 (舵机三点标定 / 腿长 / 机身尺寸 / 关节限位 / IMU 零偏 / 磁力计 / 电池系数)
    //   留待下一轮 —— 固件侧接口都在, 但 cal_ik/set_body_dims/set_joint_limits 目前返回 None
    //   而不是 bool (motion_task_mpy.c:85/182/199), 要做"被拒就嘤嘤"得先改固件。
    // ⚠ 这个块会**写 NVS** (set_center 内部调 motion_save_geometry, motion_task.cpp:1052),
    //   每跑一次写一次 flash, 且值跨重启保留。**被拒时不写** —— 两道校验都在 save 之前返回。
    // ★★ 两道闸门 —— ① |偏移| ≤ L1/2 (默认 20mm, 只看量级); ② 跟当前
    //    stride/height/lift/姿态**组合起来够不够得着**。默认 stride70/height70 下脚已伸到
    //    78.3mm、离可达上限 84 只剩 5.7mm ⇒ 重心实际最多挪 **11.4mm**, 15 / 20 会被 ② 拒掉
    //    (只判 ① 会放行 ⇒ 静默够不着、脚在地上蹭)。想挪更多先减步长:
    //    stride 60 时 15 能过, stride 50 时 19.4 能过。
    // ★ 参与 `_ok`: set_center 返回 bool。
    //   它自己**没有读回接口** (get_geometry 只返回 L1/L2/半长/半宽) ⇒ 判它成没成只能靠这个返回值。
    {
      opcode: 'setCenter',
      blockType: 'command',
      text: '$$setCenter',
      arguments: {
        OFFSET: { type: 'number', defaultValue: '0' }
      },
      // ⚠ 顶格单句 + 单行, 不许有复合语句 (见 setSpeed 详注)。
      pycode: '_ok = bpuppy_motion.set_center([OFFSET]); _ok = _ok or voice.say(*voice.SND_YING) or False'
    }
  ],
  menus: {
    gaitMenu: [
      { text: '$$go', value: 'go' },
      { text: '$$walk',   value: 'walk' },
      { text: '$$trot',   value: 'trot' },
      { text: '$$stop',   value: 'stop' }
    ],
    // 「高级运动」的方向下拉。type 'value' ⇒ 值**裸代入** pycode (和 soundMenu 一样),
    // 所以乘进 ([DIR]) * _stride 得到正/负步长。1=前进, -1=后退。
    dirMenu: [
      { text: '$$dirFwd',  value: '1' },
      { text: '$$dirBack', value: '-1' }
    ],
    servoMenu: [
      { text: '$$LF_HIP',   value: '0' },
      { text: '$$LF_KNEE',  value: '1' },
      { text: '$$LH_HIP',   value: '2' },
      { text: '$$LH_KNEE',  value: '3' },
      { text: '$$RF_HIP',   value: '4' },
      { text: '$$RF_KNEE',  value: '5' },
      { text: '$$RH_HIP',   value: '6' },
      { text: '$$RH_KNEE',  value: '7' },
      { text: '$$EXT1',     value: '8' },
      { text: '$$EXT2',     value: '9' },
      { text: '$$EXT3',     value: '10' }
    ],
    voiceMenu: [
      { text: '$$voiceCmdStop',   value: 'Stop' },
      { text: '$$voiceCmdFwd',    value: 'Fwd' },
      { text: '$$voiceCmdBack',   value: 'Back' },
      { text: '$$voiceCmdLeft',   value: 'Left' },
      { text: '$$voiceCmdRight',  value: 'Right' },
      { text: '$$voiceCmdFaster', value: 'Faster' },
      { text: '$$voiceCmdSlower', value: 'Slower' },
      { text: '$$voiceCmdNod',    value: 'Nod' },
      { text: '$$voiceCmdStand',  value: 'Stand' },
      { text: '$$voiceCmdCrouch', value: 'Crouch' },
      { text: '$$voiceCmdSit',    value: 'Sit' },
      { text: '$$voiceCmdWave',   value: 'Wave' },
      { text: '$$voiceCmdPlay',   value: 'Play' },
      { text: '$$voiceCmdVolt',   value: 'Volt' },
      { text: '$$voiceCmdSoundDir', value: 'SoundDir' }
    ],
    // 「狗叫」积木的下拉。value 会被裸代入 pycode 的属性名 (voice.SND_[SOUND]),
    // 所以必须与 frozen/voice.py 里 SND_<value> 常量名对得上; 加新声音在这里加一行。
    soundMenu: [
      { text: '$$sndWang', value: 'WANG' },
      { text: '$$sndYing', value: 'YING' }
    ]
  }
}
