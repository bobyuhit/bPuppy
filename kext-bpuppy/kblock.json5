{
  libs:{
    "*":{import:'import poses, bpuppy_motion, bpuppy_servo, bpuppy_imu, voice, time\nfrom time import sleep\n\n_speed = 2.5\n_stride = 70\n_height = 70\n\n# 原厂已 init_all + 站姿待命, 不再重复初始化 (init_all 非幂等, 重复会失能跳变)\n# IMU 需手动「初始化 IMU」后使用 (bpuppy_imu.read_angles)\n# 语音: voice 上电已自启动 (UART2/9600 + 后台线程), 事件积木函数 voiceWhen* 自动注册\nvoice.set_main_globals(globals())   # 事件函数扫描用主全局 (sys.modules[__main__] 为 None)'},
  },
  blocks: [
    "## $$cat_motion",
    {
      opcode: 'forward',
      blockType: 'command',
      text: '$$forward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'backward',
      blockType: 'command',
      text: '$$backward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, -abs(_stride), _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnLeft',
      blockType: 'command',
      text: '$$turnLeft',
      pycode: "bpuppy_motion.set_turn(-0.8); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnRight',
      blockType: 'command',
      text: '$$turnRight',
      pycode: "bpuppy_motion.set_turn(0.8); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'stop',
      blockType: 'command',
      text: '$$stop',
      pycode: "bpuppy_motion.set_gait('stop')"
    },
    "---",
    "## $$cat_gait",
    // ===== 组合块: 一次设完所有运动参数 (2026-09-27) =====
    // 「高级运动」的 text 是**数组** ⇒ 每个元素渲染成一行 (竖排)。
    //   依据 (KittenBlock 自带 resources/app/web/lib.min.js): 生成块 JSON 的
    //   `while (inTextNum < blockText.length || inBranchNum < branchCount)` 循环在 switch
    //   **之外**, 而 branchCount 只在 conditional/loop 里赋值 ⇒ command 块的 branchCount 是
    //   undefined, 子堆栈那支永不执行, 数组的每一项就各自成为 messageN/argsN 一行,
    //   且每行同样走 `replace(/\[(.+?)]/g, convertPlaceholders)` —— 参数照常解析, 无空槽。
    //   (conditional 路线也能竖排, 但每个分支会插一个空子堆栈槽, 不如这个干净。)
    // ⚠ 一行只能有一个 $$key: maybeFormatMessage 只有在**整行**以 $$ 开头时才查表,
    //   且把 $$ 之后的整串当一个 key ⇒ 两行 = 两个 key (advMotion / advMotion2)。
    // pycode 用数组 (join("\r\n")), 因为单行 `if c: a; b` 里 b 也会被算进 if 体。
    {
      opcode: 'advMotion',
      blockType: 'command',
      text: ['$$advMotion', '$$advMotion2'],
      arguments: {
        GAIT:   { type: 'string', menu: 'gaitMenu', defaultValue: 'go' },
        SPEED:  { type: 'number', defaultValue: '2.5' },
        DIR:    { type: 'value',  menu: 'dirMenu',  defaultValue: '1' },
        STRIDE: { type: 'number', defaultValue: '70' },
        HEIGHT: { type: 'number', defaultValue: '70' },
        LIFT:   { type: 'number', defaultValue: '30' },
        TURN:   { type: 'number', defaultValue: '0' }
      },
      // 顺序耦合 (docs/error.md §2.2 #7): set_params 用**当前** lift 校验, set_lift 用**当前**
      // stride/height 校验。先 lift → params → 读回 lift 不对就补一次, 可覆盖全部情况。
      // [DIR] 是 value 型菜单 (裸代入) ⇒ 1=前进 / -1=后退; _stride 存正数 (旧的「后退」块用 -abs(_stride))。
      // 必须回写 _speed/_stride/_height 三个模块全局, 否则之后拖「前进/后退」会被旧值覆盖。
      // 步态放最后执行: 狗是用新参数起步的 (与现有「前进/后退」块一致)。
      pycode: [
        '_speed = [SPEED]',
        '_stride = abs([STRIDE])',
        '_height = [HEIGHT]',
        'bpuppy_motion.set_lift([LIFT])',
        'bpuppy_motion.set_params(_speed, ([DIR]) * _stride, _height)',
        'if abs(bpuppy_motion.get_params()[3] - [LIFT]) > 0.5:',
        '    bpuppy_motion.set_lift([LIFT])',
        'bpuppy_motion.set_turn([TURN])',
        'bpuppy_motion.set_gait([GAIT])'
      ]
    },
    // ⚠ set_body_pose 的签名是 (roll, pitch, yaw) —— 函数里 roll 在前, 而块上文字是
    //   "先俯仰后滚转" ⇒ pycode 里 [ROLL] 必须写在 [PITCH] 前面。写反了不报错, 只是俯仰滚转对调。
    //   它不校验、不写 NVS、设了就保持 (块里不复位, 与现有语义一致)。
    {
      opcode: 'bodyPose',
      blockType: 'command',
      text: '$$bodyPose',
      arguments: {
        PITCH: { type: 'number', defaultValue: '0' },
        ROLL:  { type: 'number', defaultValue: '0' }
      },
      pycode: 'bpuppy_motion.set_body_pose([ROLL], [PITCH], 0)'
    },
    // ⚠ 这个块会**写 NVS** (set_center 内部调 motion_save_geometry, motion_task.cpp:983),
    //   每跑一次写一次 flash, 且值跨重启保留。上限 ±L1/2 (默认 20mm), 超了被拒并保持原值。
    {
      opcode: 'setCenter',
      blockType: 'command',
      text: '$$setCenter',
      arguments: {
        OFFSET: { type: 'number', defaultValue: '0' }
      },
      pycode: 'bpuppy_motion.set_center([OFFSET])'
    },
    {
      opcode: 'setGait',
      blockType: 'command',
      text: '$$setGait',
      arguments: {
        GAIT: {
          type: 'string',
          menu: 'gaitMenu',
          defaultValue: 'go'
        }
      },
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_gait([GAIT])"
    },
    {
      opcode: 'setSpeed',
      blockType: 'command',
      text: '$$setSpeed',
      arguments: {
        SPEED: {
          type: 'number',
          defaultValue: '2.5'
        }
      },
      pycode: '_speed = [SPEED]; bpuppy_motion.set_params(_speed, _stride, _height)'
    },
    {
      opcode: 'setStride',
      blockType: 'command',
      text: '$$setStride',
      arguments: {
        STRIDE: {
          type: 'number',
          defaultValue: '70'
        }
      },
      pycode: '_stride = [STRIDE]; bpuppy_motion.set_params(_speed, _stride, _height)'
    },
    {
      opcode: 'setHeight',
      blockType: 'command',
      text: '$$setHeight',
      arguments: {
        HEIGHT: {
          type: 'number',
          defaultValue: '70'
        }
      },
      pycode: '_height = [HEIGHT]; bpuppy_motion.set_params(_speed, _stride, _height)'
    },
    {
      opcode: 'setLift',
      blockType: 'command',
      text: '$$setLift',
      arguments: {
        LIFT: {
          type: 'number',
          defaultValue: '30'
        }
      },
      pycode: 'bpuppy_motion.set_lift([LIFT])'
    },
    {
      opcode: 'setTurn',
      blockType: 'command',
      text: '$$setTurn',
      arguments: {
        TURN: {
          type: 'number',
          defaultValue: '0'
        }
      },
      pycode: 'bpuppy_motion.set_turn([TURN])'
    },
    {
      opcode: 'getSpeed',
      blockType: 'reporter',
      text: '$$getSpeed',
      pycode: 'bpuppy_motion.get_params()[0]'
    },
    {
      opcode: 'getStride',
      blockType: 'reporter',
      text: '$$getStride',
      pycode: 'bpuppy_motion.get_params()[1]'
    },
    {
      opcode: 'getHeight',
      blockType: 'reporter',
      text: '$$getHeight',
      pycode: 'bpuppy_motion.get_params()[2]'
    },
    {
      opcode: 'getLift',
      blockType: 'reporter',
      text: '$$getLift',
      pycode: 'bpuppy_motion.get_params()[3]'
    },
    {
      opcode: 'getTurn',
      blockType: 'reporter',
      text: '$$getTurn',
      pycode: 'bpuppy_motion.get_params()[5]'
    },
    "---",
    "## $$cat_pose",
    {
      opcode: 'stand',
      blockType: 'command',
      text: '$$stand',
      pycode: "poses.stand()"
    },
    {
      opcode: 'crouch',
      blockType: 'command',
      text: '$$crouch',
      pycode: "poses.crouch()"
    },
    {
      opcode: 'sit',
      blockType: 'command',
      text: '$$sit',
      pycode: "poses.sit()"
    },
    {
      opcode: 'playBow',
      blockType: 'command',
      text: '$$playBow',
      pycode: "poses.play()"
    },
    {
      opcode: 'waveBlock',
      blockType: 'command',
      text: '$$waveBlock',
      pycode: "poses.wave()"
    },
    "---",
    "## $$cat_servo",
    {
      opcode: 'setServo',
      blockType: 'command',
      text: '$$setServo',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        },
        ANGLE: {
          type: 'number',
          defaultValue: '90'
        }
      },
      pycode: 'poses.set_servo([SERVO],[ANGLE])'
    },
    {
      opcode: 'setStep',
      blockType: 'command',
      text: '$$setStep',
      arguments: {
        STEP: {
          type: 'number',
          defaultValue: '3'
        }
      },
      pycode: 'poses.set_step([STEP])'
    },
    {
      opcode: 'commitPose',
      blockType: 'command',
      text: '$$commitPose',
      pycode: 'poses.commit()'
    },
    {
      opcode: 'getServoAngle',
      blockType: 'reporter',
      text: '$$getServoAngle',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        }
      },
      pycode: 'poses.get_servo_angle([SERVO])'
    },
    "---",
    "## $$cat_action",
    {
      opcode: 'oscillate',
      blockType: 'command',
      text: '$$oscillate',
      arguments: {
        SERVO2: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '1'
        },
        AMP: {
          type: 'number',
          defaultValue: '10'
        },
        HZ: {
          type: 'number',
          defaultValue: '4'
        },
        CYCLES: {
          type: 'number',
          defaultValue: '8'
        }
      },
      pycode: 'poses.oscillate([SERVO2],[AMP],[HZ],[CYCLES])'
    },
    {
      opcode: 'waitSec',
      blockType: 'command',
      text: '$$waitSec',
      arguments: {
        SEC: {
          type: 'number',
          defaultValue: '1'
        }
      },
      pycode: 'sleep([SEC])'
    },
    "---",
    "## $$cat_sensor",
    {
      opcode: 'initImu',
      blockType: 'command',
      text: '$$initImu',
      pycode: 'bpuppy_imu.init(0, 14, 21, 0x68)'
    },
    {
      opcode: 'getRoll',
      blockType: 'reporter',
      text: '$$getRoll',
      pycode: 'bpuppy_imu.read_angles()[0]'
    },
    {
      opcode: 'getPitch',
      blockType: 'reporter',
      text: '$$getPitch',
      pycode: 'bpuppy_imu.read_angles()[1]'
    },
    {
      opcode: 'getYaw',
      blockType: 'reporter',
      text: '$$getYaw',
      pycode: 'bpuppy_imu.read_angles()[2]'
    },
    "---",
    "## $$cat_voice",
    {
      opcode: 'voiceWhen',
      blockType: 'hat',
      text: '$$voiceWhen',
      micropy: { instance: 'voice.start()' },
      pycode: ['def voiceWhen[VOICE]()'],
      arguments: {
        VOICE: {
          type: 'value',
          menu: 'voiceMenu',
          defaultValue: 'Fwd'
        }
      }
    },
    {
      opcode: 'getSoundAngle',
      blockType: 'reporter',
      text: '$$getSoundAngle',
      pycode: 'voice.SoundAngle'
    },
    // ⚠ 这个积木的 pycode 必须是**纯 ASCII**。KittenBlock 生成/下发代码时会把非 ASCII
    //   字符抹掉: 写成 voice.play('汪汪') 会变成 voice.play('') → play() 查不到名字回退到
    //   汪汪, 结果点哪个声音都汪汪 (实测 2026-09-26)。所以这里用 voice.say(*voice.SND_xxx)
    //   而不是声音名字 —— 码值的唯一真源仍在 frozen/voice.py 的 SND_WANG / SND_YING。
    // 2026-09-27: 原「语音播放汪汪」/「语音播放嘤嘤」两个积木合并成这一个下拉积木。
    //   加新声音 = frozen/voice.py 加一个 SND_xxx 常量 (第 4 字节不同) + 下面 soundMenu
    //   加一行, 这个积木的 pycode 不用动。
    {
      opcode: 'voiceSound',
      blockType: 'command',
      text: '$$voiceSound',
      arguments: {
        SOUND: {
          type: 'value',
          menu: 'soundMenu',
          defaultValue: 'WANG'
        }
      },
      pycode: 'voice.say(*voice.SND_[SOUND])'
    },
    // 播报数字: 滑块 0-100 (与 frozen/voice.py 的 NUM_MIN/NUM_MAX 对应) → 帧 AA 55 72 <n> 55 AA。
    // 固件侧还会再钳一道 (REPL 手敲 / 变量传值都可能越界), 所以滑块范围改了要同步改常量注释。
    {
      opcode: 'voiceSayNum',
      blockType: 'command',
      text: '$$voiceSayNum',
      arguments: {
        NUM: {
          type: 'slider',
          defaultValue: '0',
          min: 0,
          max: 100
        }
      },
      pycode: 'voice.say_num([NUM])'
    }
  ],
  menus: {
    gaitMenu: [
      { text: '$$go', value: 'go' },
      { text: '$$walk',   value: 'walk' },
      { text: '$$trot',   value: 'trot' },
      { text: '$$stop',   value: 'stop' }
    ],
    // 「高级运动」的方向下拉。type 'value' ⇒ 值**裸代入** pycode (和 soundMenu 一样),
    // 所以乘进 ([DIR]) * _stride 得到正/负步长。1=前进, -1=后退。
    dirMenu: [
      { text: '$$dirFwd',  value: '1' },
      { text: '$$dirBack', value: '-1' }
    ],
    servoMenu: [
      { text: '$$LF_HIP',   value: '0' },
      { text: '$$LF_KNEE',  value: '1' },
      { text: '$$LH_HIP',   value: '2' },
      { text: '$$LH_KNEE',  value: '3' },
      { text: '$$RF_HIP',   value: '4' },
      { text: '$$RF_KNEE',  value: '5' },
      { text: '$$RH_HIP',   value: '6' },
      { text: '$$RH_KNEE',  value: '7' },
      { text: '$$EXT1',     value: '8' },
      { text: '$$EXT2',     value: '9' },
      { text: '$$EXT3',     value: '10' }
    ],
    voiceMenu: [
      { text: '$$voiceCmdStop',   value: 'Stop' },
      { text: '$$voiceCmdFwd',    value: 'Fwd' },
      { text: '$$voiceCmdBack',   value: 'Back' },
      { text: '$$voiceCmdLeft',   value: 'Left' },
      { text: '$$voiceCmdRight',  value: 'Right' },
      { text: '$$voiceCmdFaster', value: 'Faster' },
      { text: '$$voiceCmdSlower', value: 'Slower' },
      { text: '$$voiceCmdNod',    value: 'Nod' },
      { text: '$$voiceCmdStand',  value: 'Stand' },
      { text: '$$voiceCmdCrouch', value: 'Crouch' },
      { text: '$$voiceCmdSit',    value: 'Sit' },
      { text: '$$voiceCmdWave',   value: 'Wave' },
      { text: '$$voiceCmdPlay',   value: 'Play' },
      { text: '$$voiceCmdVolt',   value: 'Volt' },
      { text: '$$voiceCmdSoundDir', value: 'SoundDir' }
    ],
    // 「狗叫」积木的下拉。value 会被裸代入 pycode 的属性名 (voice.SND_[SOUND]),
    // 所以必须与 frozen/voice.py 里 SND_<value> 常量名对得上; 加新声音在这里加一行。
    soundMenu: [
      { text: '$$sndWang', value: 'WANG' },
      { text: '$$sndYing', value: 'YING' }
    ]
  }
}
