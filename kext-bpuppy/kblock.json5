{
  libs:{
    "*":{import:'import poses, bpuppy_motion, bpuppy_servo, time\nfrom time import sleep\n\n# ===== bPuppy 初始化 =====\n_speed = 2.5\n_stride = 70\n_height = 70\n\nbpuppy_servo.init_all()\nbpuppy_servo.load_cal()\nposes.set(0,135); poses.set(1,45)\nposes.set(2,45); poses.set(3,135)\nposes.set(4,45); poses.set(5,135)\nposes.set(6,135); poses.set(7,45)\nposes.commit()'},
  },
  blocks: [
    "## 运动",
    {
      opcode: 'forward',
      blockType: 'command',
      text: '前进',
      pycode: "poses.go(_speed,_stride,_height)\n"
    },
    {
      opcode: 'backward',
      blockType: 'command',
      text: '后退',
      pycode: "poses.go(_speed,-abs(_stride),_height)\n"
    },
    {
      opcode: 'turnLeft',
      blockType: 'command',
      text: '左转',
      pycode: "poses.go(_speed,_stride,_height,-0.8)\n"
    },
    {
      opcode: 'turnRight',
      blockType: 'command',
      text: '右转',
      pycode: "poses.go(_speed,_stride,_height,0.8)\n"
    },
    {
      opcode: 'stop',
      blockType: 'command',
      text: '停止',
      pycode: "poses.stop_motion()\n"
    },
    "---",
    "## 参数",
    {
      opcode: 'setSpeed',
      blockType: 'command',
      text: '速度设为 [SPEED]',
      arguments: {
        SPEED: {
          type: 'number',
          defaultValue: '2.5'
        }
      },
      pycode: '_speed = [SPEED]; bpuppy_motion.set_params(_speed, _stride, _height)\n'
    },
    {
      opcode: 'setStride',
