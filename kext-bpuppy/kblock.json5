{
  libs:{
    "*":{import:'import poses, bpuppy_motion, bpuppy_servo, bpuppy_imu, time\nfrom time import sleep\n\n_speed = 2.5\n_stride = 70\n_height = 70\n\n# 原厂已 init_all + 站姿待命, 不再重复初始化 (init_all 非幂等, 重复会失能跳变)\n# IMU 需手动「初始化 IMU」后使用 (bpuppy_imu.read_angles)'},
  },
  blocks: [
    "## 运动",
    {
      opcode: 'forward',
      blockType: 'command',
      text: '前进', text_en: 'Forward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'backward',
      blockType: 'command',
      text: '后退', text_en: 'Backward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, -abs(_stride), _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnLeft',
      blockType: 'command',
      text: '左转', text_en: 'Turn Left',
