{
  libs:{
    "*":{import:'import poses, bpuppy_motion, bpuppy_servo, bpuppy_imu, voice, time\nfrom time import sleep\n\n_speed = 2.5\n_stride = 70\n_height = 70\n\n# _ok: 上一次设置类积木是否真的生效 (被拒时固件保持原值, 读回比对为 False)\n#   设置块尾部会把 get_params() 读回来比对并更新它; 「设置成功？」积木就是读这个值。\n_ok = True\n\n# 原厂已 init_all + 站姿待命, 不再重复初始化 (init_all 非幂等, 重复会失能跳变)\n# IMU 需手动「初始化 IMU」后使用 (bpuppy_imu.read_angles)\n# 语音: voice 上电已自启动 (UART2/9600 + 后台线程), 事件积木函数 voiceWhen* 自动注册\nvoice.set_main_globals(globals())   # 事件函数扫描用主全局 (sys.modules[__main__] 为 None)'},
  },
  blocks: [
    "## $$cat_motion",
    {
      opcode: 'forward',
      blockType: 'command',
      text: '$$forward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'backward',
      blockType: 'command',
      text: '$$backward',
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_params(_speed, -abs(_stride), _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnLeft',
      blockType: 'command',
      text: '$$turnLeft',
      pycode: "bpuppy_motion.set_turn(-0.8); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'turnRight',
      blockType: 'command',
      text: '$$turnRight',
      pycode: "bpuppy_motion.set_turn(0.8); bpuppy_motion.set_params(_speed, _stride, _height); bpuppy_motion.set_gait('go')"
    },
    {
      opcode: 'stop',
      blockType: 'command',
      text: '$$stop',
      pycode: "bpuppy_motion.set_gait('stop')"
    },
    "---",
    "## $$cat_gait",
    // ===== 组合块: 一次设完 步长/身体高度/抬脚高度 (2026-09-27 改版) =====
    // 2026-09-27 用户改版: 原 7 槽的「高级运动」拆开 —— 本块只管三个身体尺寸;
    //   步态/速度/方向/转弯率回归单参数小块 (「速度设为」并入方向下拉, 见下面 setSpeed),
    //   对应的「步长设为」「身体高度设为」「抬脚高度设为」三个块已删除。
    //   (分类名 `cat_gait` 也改叫「高级运动」了, 块本身叫「运动参数」。)
    // ⚠ 这个块的 text 是**一行**(单个 $$key)。就算写成数组也**不会竖排** —— 2026-09-27 实测,
    //   见 §5.3: KittenBlock 给每个扩展积木硬写了 inputsInline: true, scratch-blocks 就把
    //   所有值输入挤回同一行。能强制换行的只有语句输入槽 (SUBSTACK), 那要 conditional +
    //   branchCount, 代价是行间多一个空 C 形槽 —— 不值。**要让积木短, 靠缩文案, 别指望换行。**
    // ⚠ 一行只能有一个 $$key: maybeFormatMessage 只有在**整行**以 $$ 开头时才查表,
    //   且把 $$ 之后的整串当一个 key。
    // pycode 用数组 (join("\r\n")), 因为单行 `if c: a; b` 里 b 也会被算进 if 体。
    {
      opcode: 'advMotion',
      blockType: 'command',
      text: '$$advMotion',
      arguments: {
        STRIDE: { type: 'number', defaultValue: '70' },
        HEIGHT: { type: 'number', defaultValue: '70' },
        LIFT:   { type: 'number', defaultValue: '30' }
      },
      // 顺序耦合 (docs/error.md §2.2 #7): set_params 用**当前** lift 校验, set_lift 用**当前**
      // stride/height 校验。先 lift → params → 读回 lift 不对就补一次, 可覆盖全部情况。
      // ⚠ 方向**不在这个块里**: 本块只改尺寸, 前后沿用板上当前步长的符号
      //   (get_params()[1] >= 0 即前进) —— 所以「后退」之后再来改步长, 狗不会掉头。
      // 必须回写 _stride/_height 两个模块全局 (正数), 否则之后拖「前进/后退」会被旧值覆盖。
      // 步态**不在这里设**: 改尺寸不打断当前步态, 狗该怎么走还怎么走。
      // 尾部**读回比对**: 组合超限时固件整组拒绝并保持原值, 三个值对不上 ⇒ _ok = False + 嘤嘤叫。
      // 容差 0.5mm 只为容忍固件取整 —— 被拒时差的是几十 mm, 必判 False。
      pycode: [
        '_stride = abs([STRIDE])',
        '_height = [HEIGHT]',
        '_dir = 1 if bpuppy_motion.get_params()[1] >= 0 else -1',
        'bpuppy_motion.set_lift([LIFT])',
        'bpuppy_motion.set_params(_speed, _dir * _stride, _height)',
        'if abs(bpuppy_motion.get_params()[3] - [LIFT]) > 0.5:',
        '    bpuppy_motion.set_lift([LIFT])',
        '_p = bpuppy_motion.get_params()',
        '_ok = abs(_p[1] - _dir * _stride) < 0.5 and abs(_p[2] - _height) < 0.5 and abs(_p[3] - [LIFT]) < 0.5',
        'if not _ok:',
        '    voice.say(*voice.SND_YING)'
      ]
    },
    // ⚠ set_body_pose 的签名是 (roll, pitch, yaw) —— 函数里 roll 在前, 而块上文字是
    //   "先俯仰后滚转" ⇒ pycode 里 [ROLL] 必须写在 [PITCH] 前面。写反了不报错, 只是俯仰滚转对调。
    //   它不校验、不写 NVS、设了就保持 (块里不复位, 与现有语义一致)。
    {
      opcode: 'bodyPose',
      blockType: 'command',
      text: '$$bodyPose',
      arguments: {
        PITCH: { type: 'number', defaultValue: '0' },
        ROLL:  { type: 'number', defaultValue: '0' }
      },
      pycode: 'bpuppy_motion.set_body_pose([ROLL], [PITCH], 0)'
    },
    // ⚠ 这个块会**写 NVS** (set_center 内部调 motion_save_geometry, motion_task.cpp:983),
    //   每跑一次写一次 flash, 且值跨重启保留。上限 ±L1/2 (默认 20mm), 超了被拒并保持原值。
    // ⚠ 它**不参与 `_ok`**: get_geometry() 只返回 (L1, L2, 半长, 半宽), 重心偏移没有读回接口
    //   ⇒ 被拒时**没有**嘤嘤叫, 「设置成功？」也停在上一块设置的结果上。文档里写明。
    {
      opcode: 'setCenter',
      blockType: 'command',
      text: '$$setCenter',
      arguments: {
        OFFSET: { type: 'number', defaultValue: '0' }
      },
      pycode: 'bpuppy_motion.set_center([OFFSET])'
    },
    {
      opcode: 'setGait',
      blockType: 'command',
      text: '$$setGait',
      arguments: {
        GAIT: {
          type: 'string',
          menu: 'gaitMenu',
          defaultValue: 'go'
        }
      },
      pycode: "bpuppy_motion.set_turn(0); bpuppy_motion.set_gait([GAIT])"
    },
    // 2026-09-27 改版: 原「速度设为」并入「方向」下拉 ⇒ 「速度 [SPEED] 方向 [DIR]」。
    //   方向 = 步长的符号: [DIR] 是 value 型菜单 (值裸代入) ⇒ 1=前进 / -1=后退。
    //   只动速度/方向 —— 高度/抬脚/转弯率/步态都不碰; 狗在走的话是**边走边改**。
    //   速度不打断步态, 也**不会**让站着的狗起步 (要起步还是用「前进/后退」)。
    //   同一次改版删掉了「步长设为」「身体高度设为」「抬脚高度设为」(并入「运动参数」)。
    // 尾部读回比对: 速度超 0~10 时固件整组拒绝并保持原值 ⇒ _ok = False + 嘤嘤叫。
    {
      opcode: 'setSpeed',
      blockType: 'command',
      text: '$$setSpeed',
      arguments: {
        SPEED: {
          type: 'number',
          defaultValue: '2.5'
        },
        DIR: {
          type: 'value',
          menu: 'dirMenu',
          defaultValue: '1'
        }
      },
      pycode: [
        '_speed = [SPEED]',
        'bpuppy_motion.set_params(_speed, ([DIR]) * abs(_stride), _height)',
        '_p = bpuppy_motion.get_params()',
        '_ok = abs(_p[0] - _speed) < 0.05 and abs(_p[1] - ([DIR]) * abs(_stride)) < 0.5',
        'if not _ok:',
        '    voice.say(*voice.SND_YING)'
      ]
    },
    // ⚠ set_turn 把超范围的值**静默钳到 ±1** (不报错、不返回) ⇒ 只有读回比对才发现。
    {
      opcode: 'setTurn',
      blockType: 'command',
      text: '$$setTurn',
      arguments: {
        TURN: {
          type: 'number',
          defaultValue: '0'
        }
      },
      pycode: [
        'bpuppy_motion.set_turn([TURN])',
        '_ok = abs(bpuppy_motion.get_params()[5] - [TURN]) < 0.05',
        'if not _ok:',
        '    voice.say(*voice.SND_YING)'
      ]
    },
    // ---- 读数积木 (读**板上生效值**) ----
    // ⚠ `disableMonitor: false` 是**必须写的**: KittenBlock 把舞台 monitor 的勾选框放宽到了任意
    //   reporter (GUI 侧条件 `!disableMonitor && 无参数`, lib.min.js:748702), 但主控板扩展的建块
    //   路径把 reporter 的 `disableMonitor` **默认写成 true** (lib.min.js:639959) ⇒ 不写这一行,
    //   积木栏里就**没有勾选框**, 用户没法把它们放到舞台上实时看生效值。
    //   (带参数的 reporter 想开监控还要再加 `forceEnableMonitor: true` —— 「舵机角度」没开, 另议。)
    // ⚠ 舞台读数框 = **每帧**求值一次 = 每帧一趟串口往返, 没有节流 ⇒ 数字会跳得比实际慢。
    // ⚠ 主控板模式**没有「外观」分类** ⇒ 「说」积木拿不到, 文档里别教"塞进说"。
    {
      opcode: 'getSpeed',
      blockType: 'reporter',
      text: '$$getSpeed',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[0]'
    },
    {
      opcode: 'getStride',
      blockType: 'reporter',
      text: '$$getStride',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[1]'
    },
    {
      opcode: 'getHeight',
      blockType: 'reporter',
      text: '$$getHeight',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[2]'
    },
    {
      opcode: 'getLift',
      blockType: 'reporter',
      text: '$$getLift',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[3]'
    },
    {
      opcode: 'getTurn',
      blockType: 'reporter',
      text: '$$getTurn',
      disableMonitor: false,
      pycode: 'bpuppy_motion.get_params()[5]'
    },
    // 「设置成功？」: 上一次设置类积木(运动参数/速度/转弯率)是否**真的生效**。
    // 原理: 写完把 get_params() 读回来比对 —— 被拒时固件保持原值, 值对不上就是 False。
    // 不依赖固件版本, 顺带能抓到 set_turn 的静默钳位(±1)。
    // ⚠ 「重心偏移」没有读回接口 ⇒ 它不参与 _ok。
    {
      opcode: 'setOk',
      blockType: 'boolean',
      text: '$$setOk',
      pycode: '_ok'
    },
    "---",
    "## $$cat_pose",
    {
      opcode: 'stand',
      blockType: 'command',
      text: '$$stand',
      pycode: "poses.stand()"
    },
    {
      opcode: 'crouch',
      blockType: 'command',
      text: '$$crouch',
      pycode: "poses.crouch()"
    },
    {
      opcode: 'sit',
      blockType: 'command',
      text: '$$sit',
      pycode: "poses.sit()"
    },
    {
      opcode: 'playBow',
      blockType: 'command',
      text: '$$playBow',
      pycode: "poses.play()"
    },
    {
      opcode: 'waveBlock',
      blockType: 'command',
      text: '$$waveBlock',
      pycode: "poses.wave()"
    },
    "---",
    "## $$cat_servo",
    {
      opcode: 'setServo',
      blockType: 'command',
      text: '$$setServo',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        },
        ANGLE: {
          type: 'number',
          defaultValue: '90'
        }
      },
      pycode: 'poses.set_servo([SERVO],[ANGLE])'
    },
    {
      opcode: 'setStep',
      blockType: 'command',
      text: '$$setStep',
      arguments: {
        STEP: {
          type: 'number',
          defaultValue: '3'
        }
      },
      pycode: 'poses.set_step([STEP])'
    },
    {
      opcode: 'commitPose',
      blockType: 'command',
      text: '$$commitPose',
      pycode: 'poses.commit()'
    },
    {
      opcode: 'getServoAngle',
      blockType: 'reporter',
      text: '$$getServoAngle',
      arguments: {
        SERVO: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '0'
        }
      },
      pycode: 'poses.get_servo_angle([SERVO])'
    },
    "---",
    "## $$cat_action",
    {
      opcode: 'oscillate',
      blockType: 'command',
      text: '$$oscillate',
      arguments: {
        SERVO2: {
          type: 'string',
          menu: 'servoMenu',
          defaultValue: '1'
        },
        AMP: {
          type: 'number',
          defaultValue: '10'
        },
        HZ: {
          type: 'number',
          defaultValue: '4'
        },
        CYCLES: {
          type: 'number',
          defaultValue: '8'
        }
      },
      pycode: 'poses.oscillate([SERVO2],[AMP],[HZ],[CYCLES])'
    },
    {
      opcode: 'waitSec',
      blockType: 'command',
      text: '$$waitSec',
      arguments: {
        SEC: {
          type: 'number',
          defaultValue: '1'
        }
      },
      pycode: 'sleep([SEC])'
    },
    "---",
    "## $$cat_sensor",
    {
      opcode: 'initImu',
      blockType: 'command',
      text: '$$initImu',
      pycode: 'bpuppy_imu.init(0, 14, 21, 0x68)'
    },
    {
      opcode: 'getRoll',
      blockType: 'reporter',
      text: '$$getRoll',
      pycode: 'bpuppy_imu.read_angles()[0]'
    },
    {
      opcode: 'getPitch',
      blockType: 'reporter',
      text: '$$getPitch',
      pycode: 'bpuppy_imu.read_angles()[1]'
    },
    {
      opcode: 'getYaw',
      blockType: 'reporter',
      text: '$$getYaw',
      pycode: 'bpuppy_imu.read_angles()[2]'
    },
    "---",
    "## $$cat_voice",
    {
      opcode: 'voiceWhen',
      blockType: 'hat',
      text: '$$voiceWhen',
      micropy: { instance: 'voice.start()' },
      pycode: ['def voiceWhen[VOICE]()'],
      arguments: {
        VOICE: {
          type: 'value',
          menu: 'voiceMenu',
          defaultValue: 'Fwd'
        }
      }
    },
    {
      opcode: 'getSoundAngle',
      blockType: 'reporter',
      text: '$$getSoundAngle',
      pycode: 'voice.SoundAngle'
    },
    // ⚠ 这个积木的 pycode 必须是**纯 ASCII**。KittenBlock 生成/下发代码时会把非 ASCII
    //   字符抹掉: 写成 voice.play('汪汪') 会变成 voice.play('') → play() 查不到名字回退到
    //   汪汪, 结果点哪个声音都汪汪 (实测 2026-09-26)。所以这里用 voice.say(*voice.SND_xxx)
    //   而不是声音名字 —— 码值的唯一真源仍在 frozen/voice.py 的 SND_WANG / SND_YING。
    // 2026-09-27: 原「语音播放汪汪」/「语音播放嘤嘤」两个积木合并成这一个下拉积木。
    //   加新声音 = frozen/voice.py 加一个 SND_xxx 常量 (第 4 字节不同) + 下面 soundMenu
    //   加一行, 这个积木的 pycode 不用动。
    {
      opcode: 'voiceSound',
      blockType: 'command',
      text: '$$voiceSound',
      arguments: {
        SOUND: {
          type: 'value',
          menu: 'soundMenu',
          defaultValue: 'WANG'
        }
      },
      pycode: 'voice.say(*voice.SND_[SOUND])'
    },
    // 播报数字: 滑块 0-100 (与 frozen/voice.py 的 NUM_MIN/NUM_MAX 对应) → 帧 AA 55 72 <n> 55 AA。
    // 固件侧还会再钳一道 (REPL 手敲 / 变量传值都可能越界), 所以滑块范围改了要同步改常量注释。
    {
      opcode: 'voiceSayNum',
      blockType: 'command',
      text: '$$voiceSayNum',
      arguments: {
        NUM: {
          type: 'slider',
          defaultValue: '0',
          min: 0,
          max: 100
        }
      },
      pycode: 'voice.say_num([NUM])'
    }
  ],
  menus: {
    gaitMenu: [
      { text: '$$go', value: 'go' },
      { text: '$$walk',   value: 'walk' },
      { text: '$$trot',   value: 'trot' },
      { text: '$$stop',   value: 'stop' }
    ],
    // 「高级运动」的方向下拉。type 'value' ⇒ 值**裸代入** pycode (和 soundMenu 一样),
    // 所以乘进 ([DIR]) * _stride 得到正/负步长。1=前进, -1=后退。
    dirMenu: [
      { text: '$$dirFwd',  value: '1' },
      { text: '$$dirBack', value: '-1' }
    ],
    servoMenu: [
      { text: '$$LF_HIP',   value: '0' },
      { text: '$$LF_KNEE',  value: '1' },
      { text: '$$LH_HIP',   value: '2' },
      { text: '$$LH_KNEE',  value: '3' },
      { text: '$$RF_HIP',   value: '4' },
      { text: '$$RF_KNEE',  value: '5' },
      { text: '$$RH_HIP',   value: '6' },
      { text: '$$RH_KNEE',  value: '7' },
      { text: '$$EXT1',     value: '8' },
      { text: '$$EXT2',     value: '9' },
      { text: '$$EXT3',     value: '10' }
    ],
    voiceMenu: [
      { text: '$$voiceCmdStop',   value: 'Stop' },
      { text: '$$voiceCmdFwd',    value: 'Fwd' },
      { text: '$$voiceCmdBack',   value: 'Back' },
      { text: '$$voiceCmdLeft',   value: 'Left' },
      { text: '$$voiceCmdRight',  value: 'Right' },
      { text: '$$voiceCmdFaster', value: 'Faster' },
      { text: '$$voiceCmdSlower', value: 'Slower' },
      { text: '$$voiceCmdNod',    value: 'Nod' },
      { text: '$$voiceCmdStand',  value: 'Stand' },
      { text: '$$voiceCmdCrouch', value: 'Crouch' },
      { text: '$$voiceCmdSit',    value: 'Sit' },
      { text: '$$voiceCmdWave',   value: 'Wave' },
      { text: '$$voiceCmdPlay',   value: 'Play' },
      { text: '$$voiceCmdVolt',   value: 'Volt' },
      { text: '$$voiceCmdSoundDir', value: 'SoundDir' }
    ],
    // 「狗叫」积木的下拉。value 会被裸代入 pycode 的属性名 (voice.SND_[SOUND]),
    // 所以必须与 frozen/voice.py 里 SND_<value> 常量名对得上; 加新声音在这里加一行。
    soundMenu: [
      { text: '$$sndWang', value: 'WANG' },
      { text: '$$sndYing', value: 'YING' }
    ]
  }
}
