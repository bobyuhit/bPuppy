+    // 因此 USB-CDC 虚拟串口不可用 —— 这不是可选项, 想恢复就得放弃语音模块的 UART2。
+    // REPL/烧录走 UART0(COM14), BLE 走射频, 均不受影响。
+    // usb_init();
     #endif
     #if MICROPY_HW_ENABLE_UART_REPL
     uart_stdout_init();
