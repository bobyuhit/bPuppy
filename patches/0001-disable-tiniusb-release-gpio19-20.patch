     #if CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG
     usb_serial_jtag_init();
     #elif CONFIG_USB_OTG_SUPPORTED
-    usb_init();
+    // bPuppy 定制: 关闭 TinyUSB, 把 GPIO19/20 让给 UART2 (CI-33T 语音, frozen/voice.py)
+    // 原因: 这两个脚是原生 USB_D-/USB_D+, 且已被 UART2 占用 (UART_TX=19, UART_RX=20)。
